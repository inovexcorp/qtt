<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.inovexcorp.queryservice</groupId>
        <artifactId>query-service</artifactId>
        <version>1.0.52-SNAPSHOT</version>
    </parent>

    <artifactId>query-service-rdf4j</artifactId>
    <packaging>bundle</packaging>
    <name>QTT :: RDF4J subset bundle</name>
    <description>
        OSGi bundle with only the RDF4J modules QTT uses (model, Rio RDF/XML and JSON-LD, SPARQL JSON results).
        Replaces rdf4j-runtime-osgi, whose mandatory imports pull in Elasticsearch, LMDB, MapDB and spatial libraries.
    </description>

    <properties>
        <embedded.rdf4j>
            rdf4j-model,rdf4j-model-api,rdf4j-model-vocabulary,rdf4j-common-annotation,rdf4j-common-exception,
            rdf4j-common-text,rdf4j-common-io,rdf4j-common-util,rdf4j-common-iterator,rdf4j-common-xml,
            rdf4j-rio-api,rdf4j-rio-rdfxml,rdf4j-rio-jsonld,rdf4j-rio-datatypes,rdf4j-rio-languages,
            rdf4j-query,rdf4j-queryresultio-api,rdf4j-queryresultio-sparqljson
        </embedded.rdf4j>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.eclipse.rdf4j</groupId>
            <artifactId>rdf4j-rio-rdfxml</artifactId>
            <version>${rdf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.rdf4j</groupId>
            <artifactId>rdf4j-rio-jsonld</artifactId>
            <version>${rdf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.rdf4j</groupId>
            <artifactId>rdf4j-queryresultio-sparqljson</artifactId>
            <version>${rdf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.rdf4j</groupId>
            <artifactId>rdf4j-query</artifactId>
            <version>${rdf4j.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Bundle-SymbolicName>${project.groupId}.${project.artifactId}</Bundle-SymbolicName>
                        <Bundle-Version>${rdf4j.version}</Bundle-Version>
                        <!-- Embed whole jars (not inline) so each keeps its META-INF/services files; Rio discovers parsers that way. -->
                        <Embed-Dependency>artifactId=${embedded.rdf4j};inline=false</Embed-Dependency>
                        <Embed-Transitive>true</Embed-Transitive>
                        <Export-Package>org.eclipse.rdf4j.*;version=${rdf4j.version}</Export-Package>
                        <!-- Everything the embedded classes reference that QTT never exercises is optional. -->
                        <Import-Package>
                            com.google.common.*;version="[30,34)",
                            com.github.jsonldjava.*,
                            com.fasterxml.jackson.*,
                            org.slf4j.*,
                            *;resolution:=optional
                        </Import-Package>
                        <_removeheaders>Private-Package,Include-Resource</_removeheaders>
                        <_nouses>true</_nouses>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
