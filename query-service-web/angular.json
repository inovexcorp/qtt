{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "query-service-ui": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src/main/resources/public",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "target/classes/META-INF/resources",
              "browser": ""
            },
            "index": "src/main/resources/public/index.html",
            "browser": "src/main/resources/public/main.ts",
            "polyfills": [
              "zone.js",
              "@angular/localize/init"
            ],
            "tsConfig": "tsconfig.app.json",
            "webWorkerTsConfig": "tsconfig.worker.json",
            "inlineStyleLanguage": "scss",
            "loader": {
              ".css": "empty"
            },
            "assets": [
              "src/main/resources/public/favicon.ico",
              "src/main/resources/public/assets"
            ],
            "styles": [
              {
                "input": "node_modules/monaco-editor/min/vs/editor/editor.main.css",
                "bundleName": "monaco-editor",
                "inject": false
              },
              "src/main/resources/public/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "6mb",
                  "maximumError": "10mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "15kb",
                  "maximumError": "150kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/main/resources/public/environments/environment.ts",
                  "with": "src/main/resources/public/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.js"
          },
          "configurations": {
            "production": {
              "buildTarget": "query-service-ui:build:production"
            },
            "development": {
              "buildTarget": "query-service-ui:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "query-service-ui:build"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "src/main/resources/public/test.ts",
            "polyfills": [
              "zone.js",
              "zone.js/testing",
              "@angular/localize/init"
            ],
            "tsConfig": "tsconfig.spec.json",
            "webWorkerTsConfig": "tsconfig.worker.json",
            "karmaConfig": "karma.conf.js",
            "inlineStyleLanguage": "scss",
            "loader": {
              ".css": "empty"
            },
            "assets": [
              "src/main/resources/public/favicon.ico",
              "src/main/resources/public/assets"
            ],
            "styles": [
              {
                "input": "node_modules/monaco-editor/min/vs/editor/editor.main.css",
                "bundleName": "monaco-editor",
                "inject": false
              },
              "src/main/resources/public/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
